{
  "name": "@monavisa/node",
  "version": "0.0.0",
  "description": "Server SDK for Mona Visa: entitlement checks, customers, features and webhook verification",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@monavisa/core": "workspace:*"
  },
  "devDependencies": {
    "viem": "2.57.4",
    "vitest": "5.0.3"
  }
}
