MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONADSCAN_API_KEY=

# apps/platform
DATABASE_URL=postgres://localhost:5432/monavisa
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# Required until the contracts are deployed and recorded in @monavisa/core
PLAN_FACTORY_ADDRESS=
SUBSCRIPTION_REGISTRY_ADDRESS=
AUTOPAY_MODULE_ADDRESS=
# Deployment block, so the indexer does not scan from genesis
START_BLOCK=0
LOG_RANGE=100
BLOCK_TAG=finalized
# Optional: enables the renewal keeper. Use a dedicated low-balance key.
KEEPER_PRIVATE_KEY=
PORT=8787
# Browser origins allowed to call the API, and hosts accepted in dashboard sign-in messages
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SIWE_DOMAINS=localhost:5174
CHECKOUT_URL=http://localhost:5173
