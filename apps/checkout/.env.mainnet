# Monad mainnet build for Cloudflare Workers: vite build --mode mainnet. Overrides .env.local.
VITE_USE_LOCAL_DEPLOYMENT=0
VITE_CHAIN_ID=143
VITE_RPC_URL=
VITE_DEV_ACCOUNT=
VITE_API_URL=https://monavisa-api-mainnet.selfbiar.workers.dev
VITE_OTHER_NETWORK_URL=https://monavisa-checkout.selfbiar.workers.dev
VITE_DASHBOARD_URL=https://monavisa-dashboard-mainnet.selfbiar.workers.dev
# No public demo plan on mainnet yet, so the demo runs on testnet.
VITE_DEMO_PLAN_URL=https://monavisa-checkout.selfbiar.workers.dev/plan/1
