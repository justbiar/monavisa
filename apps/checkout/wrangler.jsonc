{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "monavisa-checkout",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Monad mainnet build, deployed as monavisa-checkout-mainnet: wrangler deploy --env mainnet
  "env": {
    "mainnet": {
      "assets": {
        "directory": "./dist-mainnet",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
