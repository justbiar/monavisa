{
  "name": "@moncart/platform",
  "version": "0.0.0",
  "private": true,
  "description": "MonCart platform: chain indexer, renewal keeper, webhook dispatcher and HTTP API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "moncart-platform": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@moncart/core": "workspace:*",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@moncart/node": "workspace:*",
    "@types/pg": "8.23.1",
    "vitest": "5.0.3"
  }
}
